# Google Gemini API Configuration
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-1.5-flash"
GEMINI_EMBED_MODEL="text-embedding-004"

# Database Configuration (PostgreSQL / Neon)
# Create a free PostgreSQL database at https://neon.tech
# Example Neon connection string (pooled recommended for serverless/Vercel):
DATABASE_URL="postgresql://[user]:[password]@[neon-hostname]-pooler.us-east-2.aws.neon.tech/[dbname]?sslmode=require"

# Authentication
JWT_SECRET="replace-with-a-random-secure-secret-key-min-32-chars"

# Node Environment
NODE_ENV="development"
